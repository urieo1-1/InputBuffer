{
    "geode": "6.0.0-alpha.1",
    "gd": {
        "win": "2.2091",
        "android": "2.2091",
        "mac": "2.2091",
        "ios": "2.2091"
    },
    "id": "uri.inputbuffer_v1",
    "name": "InputBuffer",
    "version": "v1.0.0",
    "developer": "uri",
    "description": "Buffers your jump input for a configurable number of physics frames.",
    "dependencies": {
        "geode.node-ids": ">=v1.23.3"
    },
    "settings": {
        "enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "buffer-frames": {
            "type": "int",
            "name": "Buffer Frames",
            "description": "How many physics steps a jump release is held back (240 steps = 1 second at default TPS).",
            "default": 3,
            "min": 0,
            "max": 30,
            "control": {
                "slider": true,
                "input": true
            }
        }
    }
}
